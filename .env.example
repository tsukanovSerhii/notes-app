# Copy to .env.local and adjust. Every variable is optional.
# Only the sync server reads them; the browser app needs none.

# Postgres connection string. When set, sync spaces live in Postgres (the
# table is created on first use) and any number of server instances can serve
# sync. Without it, spaces are JSON files under SYNC_DATA_DIR.
# On Neon, `neon deploy` writes this to .env.local (use the pooled URL).
# Add sslmode=verify-full to keep pg's current TLS behaviour explicit.
# DATABASE_URL=postgres://user:password@host:5432/notevoid?sslmode=verify-full

# Where JSON-file sync spaces are stored when DATABASE_URL is not set.
# SYNC_DATA_DIR=.data/sync

# Set to "true" to turn the sync endpoint off (the app still works locally).
# SYNC_DISABLED=false

# Sync requests allowed per minute per client IP and per sync space.
# 0 turns a limit off. The IP limit reads X-Forwarded-For, so behind a
# reverse proxy make sure the proxy sets it.
# SYNC_RATE_LIMIT_IP=120
# SYNC_RATE_LIMIT_SPACE=240

# Pictures and files: storage a sync space may use (MB), where sealed chunks
# are kept without DATABASE_URL, and request limits per minute.
# SYNC_ATTACHMENT_QUOTA_MB=256
# ATTACHMENT_DATA_DIR=.data/attachments
# SYNC_ATTACHMENT_RATE_LIMIT_IP=600
# SYNC_ATTACHMENT_RATE_LIMIT_SPACE=1200
